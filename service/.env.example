# Light ships its public YouVersion application identifier. Users do not need
# a developer account or application key; sign in with a regular account.
YVP_REDIRECT_URI=omarchy://oauth/callback

# Optional runtime settings
# YVP_API_HOST=api.youversion.com
# LIGHT_CONFIG_DIR=/path/to/private/omarchy/light-public
# LIGHT_CACHE_TTL_SECONDS=604800
# LIGHT_DOWNLOAD_CONCURRENCY=1
# LIGHT_DOWNLOAD_INTERVAL_MS=1250
# LIGHT_DOWNLOAD_RETRIES=3
# LIGHT_HOST=127.0.0.1
# LIGHT_PORT=8788
